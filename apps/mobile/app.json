{
  "expo": {
    "name": "Next360",
    "slug": "next360",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "next360",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.next360.app",
      "buildNumber": "1",
      "minimumOsVersion": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Next360 uses your camera to scan QR codes for verifying product authenticity.",
        "NSPhotoLibraryUsageDescription": "Next360 accesses photos to let you set a profile picture.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSPrivacyPolicy": "https://next360.in/privacy"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.next360.app",
      "versionCode": 1,
      "minSdkVersion": 26,
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "usesCleartextTraffic": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Next360 uses your camera to scan QR codes for verifying product authenticity."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#16a34a"
        }
      ],
      "expo-splash-screen"
    ],
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "http://192.168.1.17:8080",
      "privacyPolicyUrl": "https://next360.in/privacy",
      "termsUrl": "https://next360.in/terms",
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
