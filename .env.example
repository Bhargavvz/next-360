# ============================================================
# Next360 — Environment Variables
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/next360
DATABASE_USERNAME=next360
DATABASE_PASSWORD=next360_dev_password
DATABASE_NAME=next360

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-this-to-a-secure-secret-in-production-minimum-32-chars
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# --- AWS S3 ---
S3_BUCKET=next360-uploads
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
# Leave AWS_ACCESS_KEY_ID/SECRET blank in production to use the instance IAM role.
# Optional: S3-compatible endpoint (MinIO/LocalStack) — blank means real AWS.
S3_ENDPOINT=
S3_PATH_STYLE=false
# Optional: CDN origin used to build public file URLs, e.g. https://cdn.next360.in
S3_PUBLIC_BASE_URL=
S3_PRESIGN_UPLOAD_TTL=600
S3_PRESIGN_DOWNLOAD_TTL=3600
S3_MAX_FILE_SIZE=10485760

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Secret set on the Razorpay webhook (Dashboard → Settings → Webhooks).
# Falls back to RAZORPAY_KEY_SECRET when blank.
# Webhook URL: https://<your-api-host>/api/v1/payments/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# --- Payments ---
COD_ENABLED=true
COD_MAX_ORDER_AMOUNT=20000

# --- Shipping ---
FREE_DELIVERY_THRESHOLD=499
DELIVERY_FEE=49

# --- Firebase (Push Notifications) ---
FCM_CONFIG=path/to/firebase-config.json

# --- OTP Provider (2factor.in) ---
OTP_PROVIDER_KEY=your-otp-provider-key
# Set to true to send real SMS. When false (or the key is blank) the API runs in
# dev mode: OTP_DEV_CODE is accepted and returned in the OTP request response.
OTP_ENABLED=false
OTP_DEV_CODE=123456
OTP_TEMPLATE=AUTOGEN
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=30
OTP_MAX_REQUESTS=5
OTP_REQUEST_WINDOW=900
OTP_MAX_VERIFY_ATTEMPTS=5

# --- Shipping Provider ---
SHIPPING_PROVIDER_KEY=your-shipping-provider-key

# --- AI Service ---
AI_API_KEY=your-ai-api-key

# --- Application ---
APP_ENV=development
COMMISSION_DEFAULT_PERCENTAGE=15
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Next360
NEXT_PUBLIC_APP_URL=http://localhost:3000
