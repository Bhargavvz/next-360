# ============================================================
# Next360 — Environment Variables
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/next360
DATABASE_USERNAME=next360
DATABASE_PASSWORD=next360_dev_password
DATABASE_NAME=next360

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-this-to-a-secure-secret-in-production-minimum-32-chars
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# --- AWS S3 ---
S3_BUCKET=next360-uploads
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# --- Firebase (Push Notifications) ---
FCM_CONFIG=path/to/firebase-config.json

# --- OTP Provider ---
OTP_PROVIDER_KEY=your-otp-provider-key

# --- Shipping Provider ---
SHIPPING_PROVIDER_KEY=your-shipping-provider-key

# --- AI Service ---
AI_API_KEY=your-ai-api-key

# --- Application ---
APP_ENV=development
COMMISSION_DEFAULT_PERCENTAGE=15
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Next360
NEXT_PUBLIC_APP_URL=http://localhost:3000
